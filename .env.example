# Core
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://repopilot:repopilot@localhost:5432/repopilot

# GitHub webhook and API
GITHUB_WEBHOOK_SECRET=replace-me
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=wellkilo/repopilot-testbed

# AgentTeams Matrix task injection
AGENTTEAMS_MATRIX_URL=http://127.0.0.1:18088
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.agentteams.io:8080
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=
AGENTTEAMS_MANAGER_USER=manager

# Optional OpenTelemetry exporter. Keep empty for local no-export mode.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=repopilot-control-plane

# Optional AgentLoop Recall official Skill configuration.
AGENTLOOP_ENABLE_RECALL=false
